# ───────── Public (exposed to the browser — safe values only) ─────────
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key
# Browser key, restricted by HTTP referrer to your domain(s) and to Maps JavaScript API + Places API (New)
VITE_GOOGLE_MAPS_API_KEY=
# Public site URL (used for SEO canonical links)
VITE_SITE_URL=https://dafwa.example

# ───────── Server only (Netlify Functions — NEVER prefix with VITE_) ─────────
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
RESEND_API_KEY=re_xxxxxxxxx
# Must be on a domain verified in Resend, e.g. "دفوة DAFWA <orders@dafwa.example>"
RESEND_FROM="DAFWA دفوة <orders@your-verified-domain>"
# Public URL of the deployed site (used in email links)
SITE_URL=https://dafwa.example
# Random string used to hash IP addresses for rate limiting (any long random value)
RATE_LIMIT_SALT=change-me-to-a-long-random-string
